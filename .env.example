APP_ENV=development
APP_DEBUG=false

# Copiar este archivo como .env para usar XAMPP localmente.
# Si MySQL tiene otra clave, completar DB_PASSWORD solo en el .env local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sgrsi
DB_USER=root
DB_PASSWORD=

# URL pública usada en los enlaces de recuperación de contraseña.
APP_URL=http://127.0.0.1:8001/Vista

# Correo saliente. SMTP_CIFRADO admite tls, ssl o ninguno.
SMTP_HOST=
SMTP_PORT=587
SMTP_CIFRADO=tls
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
SMTP_NOMBRE_REMITENTE=SGRSI UTU

# Directorio privado y persistente, fuera de la carpeta publicada por Apache.
# En XAMPP para Windows puede utilizarse C:\xampp\sgrsi-datos\resoluciones.
RUTA_ARCHIVOS_RESOLUCIONES=C:\xampp\sgrsi-datos\resoluciones
